	(text "J3 female 2x4 SMD 8.5 mm, inner face.\nPin=line: 1=L1, 2=L8, 3=L2, 4=L7\n5=L3, 6=L6, 7=L4, 8=L5\nMirrored (J4 on B.Cu of board B): J3 pin n mates\nJ4 pin n+1 (n odd) / n-1 (n even): J3.1-J4.2, J3.2-J4.1, J3.3-J4.4, J3.4-J4.3, ...\n(tree_common.mate_table). No supply, no ground."
		(exclude_from_sim no)
		(at 238.76 71.12 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
