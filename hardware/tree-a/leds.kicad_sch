	)
	(text "Pads: 3 anode, 1 R, 2 G, 4 B cathode. Board A: R on a+6, G on a+5, B on a+1\n(tree_common.LED_MATRIX).\nLED -> (R, G, B cathode line):\nD9 (anode L1) -> R L7, G L6, B L2\nD10 (anode L2) -> R L8, G L7, B L3\nD11 (anode L3) -> R L1, G L8, B L4\nD12 (anode L4) -> R L2, G L1, B L5\nD13 (anode L5) -> R L3, G L2, B L6\nD14 (anode L6) -> R L4, G L3, B L7\nD15 (anode L7) -> R L5, G L4, B L8\nD16 (anode L8) -> R L6, G L5, B L1"
		(exclude_from_sim no)
