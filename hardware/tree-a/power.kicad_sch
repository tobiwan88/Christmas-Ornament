	(text "Cell input: BT1 2xAAA (variant A) / J2 pouch (variant B)"
		(exclude_from_sim no)
		(at 11.43 34.04 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "16af7b5b-aa65-5e7f-ba7e-6fd86ad2e112")
	)
	(text "BT1 2xAAA holder: fitted in A, not placed in B; J2 pouch: fitted in B, DNP in A.\nBT1 pads 3/4 = far-end tabs, joined: series pack.\nA reversed BT1 cell or J2 pouch reaches Q1 only:\nVIN and U2, U3, C31, R40 stay at 0 V (D21).\nPad-to-cell mapping and J2 pin 1 = cell +:\nUNVERIFIED (continuity test). BT1 and J1/J2/U3\noverlap on the board on purpose (D15)."
		(exclude_from_sim no)
		(at 12.7 93.98 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "2b62ea4a-e939-507f-8bec-a85bf18a3a6a")
	)
	(text "C20 10uF: Cin (>= 5 uF effective, 6.3).\nR40/R41 2.2M/2.2M after Q1: VBAT_SENSE\nto P1.04 AIN0 (4.2 V -> 2.1 V), 0.68 uA\nat 3.0 V. C14 100nF: 1.1 Mohm source,\ntau 0.11 s (tree_charge_path.py, D21)."
		(exclude_from_sim no)
		(at 119.38 81.28 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "39774a72-f783-5c1d-84b0-ee43e52041d0")
	)
	(text "P-FET: D to cell +,\nS to VIN, G to GND.\nReversed cell: VGS 0,\nbody diode blocks.\nCharge (B): S->D,\non (tree_charge_path)."
		(exclude_from_sim no)
		(at 92.71 67.31 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "43ef4ba4-6ff5-580c-8d59-977b2b9448ae")
	)
	(text "EN tied to VIN (D13). SEL low = VO(1) 3.0 V (R22 13.3k, Table 7-3);\nSEL high = VO(2) 3.5 V (R20 511R + R21 10.5k, 100 mA limit, Table 7-2).\nR23 1M pull-down: 3.0 V at start, SEL never floats.\nCFG read once at start-up; 1 %, <= 200 ppm. L2 2.2 uH Isat 1.85 A.\nC21 22uF 0805 25V: Cout >= 10 uF effective.\nThermal pad 11 to GND (Table 5-1)."
		(exclude_from_sim no)
		(at 190.5 83.82 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "517dd068-1274-546b-85e4-d6c99c4a96c9")
	)
	(text "U2 TPS63900 buck-boost (SLVSET3D)"
