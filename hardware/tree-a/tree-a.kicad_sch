	)
	(text "Power path (red arrows; the rails BAT, VIN, VDD are power symbols on the sheets): cell BT1\nor pouch J2 -> BAT -> Q1 reverse-polarity P-FET -> VIN -> U2 TPS63900 -> VDD -> U1\nnRF54L10. Variant B adds USB-C J1 -> U3 MCP73831 -> VIN (charges the pouch through Q1).\nLED lines: GPIO -> R1-R8 -> J3 -> board B."
		(exclude_from_sim no)
		(at 15.24 16.51 0)
