	(text "U1 nRF54L10 (BOM, D2;\nsymbol nRF54L15-QFAA, same pins)\nDC/DC, HFXO 32 MHz, LFXO 32.768 kHz\nSWD pads TC1, SW1 + R10"
		(exclude_from_sim no)
		(at 190.5 76.2 0)
