		(uuid "9db21ea9-a51f-5289-8648-3bb96b6c19cf")
	)
	(text "U1 nRF54L15 (BOM nRF54L10, D2)\nDC/DC, HFXO 32 MHz, LFXO 32.768 kHz\nSWD pads TC1, button SW1\nLED lines on P1 (GPIOTE scan)"
		(exclude_from_sim no)
		(at 154.94 76.2 0)
