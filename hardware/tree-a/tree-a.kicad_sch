	(lib_symbols)
	(text "Power flow: cell (BT1 2xAAA, variant A) or pouch (J2, variant B; charged by U3 from USB-C J1) -> BAT -> Q1 reverse-polarity P-FET -> VIN -> U2 TPS63900 -> VDD 3.0 V idle / 3.5 V lit (SEL = TPS_SEL from U1) -> U1 nRF54L15"
		(exclude_from_sim no)
		(at 25.4 19.05 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "02df2f9f-558f-5aeb-a198-fc1edf59f7db")
	)
	(text "Variant A (order 1, D10): BT1 fitted; charger sheet (J1, J2, U3, R30-R32, R42-R45, C30, C31) DNP.\nVariant B: BT1 not fitted, charger parts fitted (bom-variant-b.csv). Holder and USB-C / JST / charger\nfootprints overlap on the board on purpose (D15).\nFirmware: INTCAP for X1/X2 (no load caps), SEL high >= 1 ms before lighting and low before sleep,\none die at a time from tree_common.slot_table(), all lines Hi-Z in sleep, read CHG_STAT/VBUS_DET at VDD 3.0 V."
		(exclude_from_sim no)
		(at 25.4 182.88 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "05f9aef9-f908-53a1-b24c-880cb1cd2bd5")
	)
	(text "Cell BT1 (A) / pouch J2 (B)\n-> Q1 P-FET -> VIN\n-> U2 TPS63900 -> VDD\nVBAT_SENSE divider"
		(exclude_from_sim no)
		(at 27.94 40.64 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "084e1a94-5ed0-5bdd-89f9-0812c17496f6")
	)
	(text "and the LED lines (GPIO -> R1-R8 -> J3 -> board B). Rails BAT, VDD, GND are power symbols on the sheets."
		(exclude_from_sim no)
		(at 25.4 24.13 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "1b8fcccf-efcb-5fa2-b590-307ae62c5111")
	)
	(text "R1-R8 22R, D9-D16,\nheader J3 to board B"
		(exclude_from_sim no)
		(at 292.1 116.84 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "5e083068-817e-5899-a4b0-b0b1abe7a2d6")
	)
	(text "VDD rail ->\n(power symbol)"
		(exclude_from_sim no)
		(at 93.98 43.18 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
