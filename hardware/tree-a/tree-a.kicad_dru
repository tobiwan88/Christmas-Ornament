(version 1)
# Custom DRC rules of tree-a (board.yaml fab.custom_drc). gen/tree_a_pcb.py copies this file next to the board as
# hardware/tree-a/tree-a.kicad_dru; edit this source, never the copy. Each rule names its reason.

# D15 (DECISIONS.md): the battery holder BT1 (variant A) and the variant B parts J1 (USB-C), J2 (JST PH pouch) and U3
# (MCP73831) are never fitted together, so their COURTYARDS may overlap. Only the courtyard check is relaxed and only for
# these pairs: copper clearance, hole clearance and every other rule still apply between them (their pads must not touch).
(rule "D15 holder vs variant B courtyards"
  (severity ignore)
  (constraint courtyard_clearance (min 0mm))
  (condition "(A.Reference == 'BT1' && (B.Reference == 'J1' || B.Reference == 'J2' || B.Reference == 'U3')) || (B.Reference == 'BT1' && (A.Reference == 'J1' || A.Reference == 'J2' || A.Reference == 'U3'))"))

# RF feed (50 ohm GCPW over In1 from the pi slot to ANT1, board.yaml net_classes.RF / rf): 0.30 mm to any other copper for
# TRACKS of the ANT_FEED net only (engineer, gate 4, review B1): the line beyond the pi slot. The matching network (ANT_PA,
# RF_N1, RF_N2, RF_50 between 0201 pads at 0.18 mm gaps and the 0.40 mm pitch ANT pin) keeps the net-class clearance, and so
# do the pads of the network parts, U1 and NT1 when an ANT_FEED track starts at R50 / C51. Other rules are unchanged.
(rule "RF feed track clearance"
  (constraint clearance (min 0.3mm))
  (condition "A.NetName == '/rf/ANT_FEED' && A.Type == 'Track' && B.Net != A.Net && !(B.Type == 'Pad' && (B.Reference == 'U1' || B.Reference == 'NT1' || B.Reference == 'L3' || B.Reference == 'L4' || B.Reference == 'L5' || B.Reference == 'C6' || B.Reference == 'C9' || B.Reference == 'C11' || B.Reference == 'C50' || B.Reference == 'R50' || B.Reference == 'C51'))"))

# kicad-layout skill: no via in an SMD pad; a same-net via keeps a copper gap to SMD pads (router guard; no vias exist at
# gate 4 except the footprints' own thermal-via pads). physical_clearance binds every net (KiCad grades it; KiCadRoutingTools
# does not read that kind); the same 0.15 as a 'clearance' constraint is what the router reads for OTHER nets (its scoped
# rule channel: Type / Pad_Type), and gen/tree_a_krt.py records same_net_pad_clearance 0.15 for the router's own-net vias.
# It raises the Default / Power class clearance (0.10 since gate 5 round 3, board.yaml) to 0.15 between a via and an SMD
# pad; RF and Crystal (0.15) are unchanged by it.
(rule "via to SMD pad"
  (constraint physical_clearance (min 0.15mm))
  (constraint clearance (min 0.15mm))
  (condition "A.Type == 'Via' && B.Type == 'Pad' && B.Pad_Type == 'SMD'"))
