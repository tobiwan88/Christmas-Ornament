	(text "PROG R32 10k: IREG 100 mA (5.1.2). C30/C31 4.7uF (3.1, 3.2).\nDividers 100k/120k: <= 3.0 V at VBUS 5.25 V (D13, tree_pin_divider.py).\nCHG_STAT: low = charging, high = done, Hi-Z reads low. Read both with\nSEL low (VDD 3.0 V). All parts here DNP in order 1 (D10); J1/U3 overlap BT1 (D15)."
		(exclude_from_sim no)
		(at 104.14 106.68 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "6a114ba5-f56a-5fbb-8446-1d690e451cbc")
	)
